{
    "name": "se7enxweb/mugo_varnish",
    "description": "Mugo Varnish for Exponential: purges the Varnish cache of the pages a publish affects, gives administrators a page to purge by condition, and can vary the cache of signed-in users by a role hash.",
    "type": "ezpublish-legacy-extension",
    "keywords": [
        "exponential",
        "exponential-legacy",
        "ezpublish-legacy",
        "extension",
        "varnish",
        "cache",
        "purge",
        "ban",
        "http-cache"
    ],
    "homepage": "https://github.com/se7enxweb/mugo_varnish",
    "support": {
        "issues": "https://github.com/se7enxweb/mugo_varnish/issues",
        "source": "https://github.com/se7enxweb/mugo_varnish"
    },
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Philipp Kamps",
            "role": "Author"
        },
        {
            "name": "Mugo Web",
            "homepage": "https://www.mugo.ca",
            "role": "Author"
        },
        {
            "name": "7x",
            "email": "info@se7enx.com",
            "homepage": "https://se7enx.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "se7enxweb/exponential-legacy-installer": "*"
    },
    "extra": {
        "ezpublish-legacy-extension-name": "mugo_varnish",
        "installer-name": "mugo_varnish"
    }
}
